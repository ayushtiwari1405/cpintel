# Host port for the Postgres container; override if 5432 is taken locally.
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
MONGO_USER=
MONGO_PASSWORD=
REDIS_PASSWORD=
# Signs access tokens. At least 32 characters — HS256 rejects anything shorter, and the
# backend refuses to start under the prod profile if this is missing or is one of the
# placeholder values that used to ship as defaults. Generate one:
#   head -c 48 /dev/urandom | base64 | tr -d '\n=' | tr '+/' '-_'
JWT_SECRET=
# Token lifetimes, in milliseconds. Blank keeps the defaults: 15 minutes and 7 days.
JWT_EXPIRY_MS=
JWT_REFRESH_EXPIRY_MS=
# Encrypts stored Codeforces session cookies. At least 16 characters; generate as above.
# Changing it makes already-stored sessions undecryptable, so they have to be reconnected.
CPINTEL_SESSION_KEY=
# Whether anyone may create their own account. Off by default: a super admin creates accounts
# from the console, so the member list of this deployment is a decision rather than whoever
# found the sign-up page. Set to true to reopen public sign-up.
CPINTEL_REGISTRATION_ENABLED=false
# The super administrator — the only account that can assign roles or create other accounts.
# An existing account with this address is promoted at startup. If no account has it, one is
# created, but only when CPINTEL_ADMIN_PASSWORD is also set: there is deliberately no default
# administrator password. See "Roles and accounts".
CPINTEL_ADMIN_EMAIL=
# Only read when the address above matches no existing account. Leave blank once it exists.
CPINTEL_ADMIN_PASSWORD=
CPINTEL_ADMIN_USERNAME=superadmin
# DOMjudge. Each classroom has its own judge, set by an admin from Admin -> Classrooms, so there
# is no judge URL or service account here.
#
# REQUIRED to attach contestants' DOMjudge accounts. AES-256-GCM key for the per-contestant
# logins; generate with `openssl rand -base64 48`. Unlike the Codeforces session key this
# protects an actual password, because DOMjudge's API is HTTP Basic and issues no session token
# a client can hold instead. Logins are stored encrypted with the student's enrolment in
# Postgres, so they last as long as the student is in the classroom and are backed up; a
# database dump without this key yields nothing. The same key encrypts each classroom's
# service-account password. Keep a copy off the server: losing it means re-attaching every login.
# At least 32 characters: the prod profile refuses a shorter one, since the key is derived with a
# single SHA-256 and only a random string makes that safe. REQUIRED in production: the prod
# profile refuses to start without it (`openssl rand -base64 48`).
CPINTEL_DOMJUDGE_CREDENTIAL_KEY=
#
# Code runner (the Run button). The token is shared by the backend and the runner container;
# generate it like the other keys. Concurrency is runs at once — about one per core you give it.
CPINTEL_RUNNER_TOKEN=
# Defaults suit a 4-core, 8 GB server; raise all three together on a bigger one.
CPINTEL_RUNNER_CONCURRENCY=3
CPINTEL_RUNNER_CPUS=3
CPINTEL_RUNNER_MEMORY=2g
#
# REQUIRED for examinations. AES-256-GCM key for each candidate's examination sign-in password
# (typed on the login page instead of their own password; it opens examination mode for that
# one paper) and for the optional room password an invigilator reads out. Generate with
# `openssl rand -base64 48`. Without it no sign-in password can be issued, so nobody can sit an
# examination — which the admin screen says plainly rather than leaving to be discovered on the
# morning of a sitting.
#
# These are encrypted rather than hashed, which is deliberate and is the one place in this
# deployment where a secret can be read back. Somebody has to: the desk slips are printed in
# the morning, and a code is re-read at eleven for the candidate whose slip went missing. See
# ExamPasswordService for the full argument. Changing this key makes every stored examination
# password unreadable, so they have to be regenerated — which is recoverable, unlike an
# account password, because they are worthless once the paper has closed anyway.
# At least 32 characters, as for the DOMjudge key above, and likewise the prod profile refuses to
# start without it.
CPINTEL_EXAM_PASSWORD_KEY=
# Characters per generated code, grouped in fours for reading off paper. 6-16.
CPINTEL_EXAM_PASSWORD_LENGTH=8
#
# How long an examination's session log is kept, in days. That log is evidence about a person,
# so how long it lives is a decision a deployment makes rather than one a default makes for it.
# 0 keeps everything, deliberately.
CPINTEL_EXAM_RETENTION_DAYS=365
#
# Email, for password resets and account notices. Nothing else uses it, and nothing about an
# examination is ever sent by mail — the passwords that open a paper are carried into the room
# on paper, which is the whole point of them.
#
# Leaving SMTP_HOST blank is a supported arrangement rather than an oversight: on a closed
# exam-lab network there is no server to point at, and the backend logs what it would have
# sent so an operator can still complete a reset by hand. It warns at startup so the choice is
# visible.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Who the mail comes from, and where a link inside it points — the address people actually open
# CPIntel at, which is not the backend's own.
CPINTEL_MAIL_FROM=CPIntel <no-reply@cpintel.local>
CPINTEL_PUBLIC_URL=http://localhost:5173
# How long a password reset link is worth, in minutes. Long enough to go and find the mail,
# short enough that one left in an inbox is not a standing key to the account.
CPINTEL_RESET_TOKEN_MINUTES=60
GRAFANA_PASSWORD=
# Where the monitoring profile emails firing alerts (backend down, runs failing, disk full…),
# through the SMTP server above. Blank sends them to CPINTEL_ADMIN_EMAIL; with no SMTP_HOST
# nothing is sent and the alerts are only on Prometheus's page.
CPINTEL_ALERT_EMAIL=
SPRING_PROFILES_ACTIVE=
#
# ── Serving it ───────────────────────────────────────────────────────────────
# The server's public name. nginx serves https for it, and the certificate is issued for it.
# Set CPINTEL_PUBLIC_URL above to https://<this> as well.
CPINTEL_DOMAIN=localhost
# Let's Encrypt, for a server the internet can reach: the address expiry notices go to. Start
# with `docker compose --profile letsencrypt up -d`. On a closed campus network leave this
# empty and put the campus certificate in nginx/certs/ instead (see the README there).
CPINTEL_ACME_EMAIL=
# Lab networks that reach the server through one NAT address, comma-separated CIDRs, e.g.
# 10.20.0.0/16. Inside them the sign-in and API rate limits are sized for a room, not a person;
# per-account limits are unchanged. Empty when every machine has its own address.
CPINTEL_LAB_NETWORKS=
#
# ── Backups (scripts/backup.sh) ──────────────────────────────────────────────
CPINTEL_BACKUP_DIR=/var/backups/cpintel
CPINTEL_BACKUP_KEEP_DAYS=14
# rsync target off this server, e.g. backup@nas:/srv/cpintel. Without it a dead disk takes the
# backups with it.
CPINTEL_BACKUP_REMOTE=

# ── Desktop app ──────────────────────────────────────────────
# deploy.sh builds the installers itself, for CPINTEL_PUBLIC_URL above, whenever that address
# or the app changes (scripts/build-desktop.sh; needs only Docker, 10-20 minutes when it runs).
# The site's /download page and the installed apps' update ribbon serve that build. Set to 0 to
# skip it, e.g. when installers come from a GitHub release instead (below).
CPINTEL_DESKTOP_BUILD=1
# Optional, instead of building on the server: the GitHub repository (owner/name) this
# deployment builds from. Pushing a tag like v1.0.0
# there builds the installers and publishes them as a release (.github/workflows/electron.yml,
# which also needs the repository variable CPINTEL_SERVER_URL). The site's /download page and
# the installed apps' update ribbon read the newest release from here when the server has no
# build of its own.
CPINTEL_DESKTOP_REPOSITORY=
# Only if that repository is private: a fine-grained token with read access to its Contents.
# Downloads are then streamed through this server instead of redirected to GitHub.
CPINTEL_DESKTOP_GITHUB_TOKEN=
# Installed apps older than this get a ribbon that cannot be closed until they update.
CPINTEL_MIN_DESKTOP_VERSION=0.0.0

# ── Images (docker-compose.prod.yml, deploy.sh) ─────────────────────────────
# deploy.sh sets CPINTEL_VERSION to the commit it deploys; set it by hand only to run
# `docker compose -f docker-compose.yml -f docker-compose.prod.yml up` yourself.
CPINTEL_VERSION=
# Where CI pushes the images, if this deployment builds from a fork: ghcr.io/<this>-backend etc.
CPINTEL_IMAGE_REPO=ayushtiwari1405/cpintel

# ── Optional tuning ─────────────────────────────────────────────────────────
# Every value below is the default; leave a line commented to keep it. All of them reach the
# containers through docker-compose.yml.
#
# Code runner. Off turns the Run button off everywhere. EXAM_ONLY keeps the server runner for
# examination sessions; everywhere else code runs on the student's own machine.
# CPINTEL_RUNNER_ENABLED=true
# CPINTEL_RUNNER_EXAM_ONLY=true
# Per test, wall clock; compile, wall clock; and memory per run.
# CPINTEL_RUNNER_TIME_LIMIT_MS=5000
# CPINTEL_RUNNER_COMPILE_LIMIT_MS=20000
# CPINTEL_RUNNER_MEMORY_MB=512
#
# Per-user and per-address request limits (sign-in, Run, sync, analytics rebuilds). Off is for
# tests only; nginx limits by address either way.
# CPINTEL_RATE_LIMIT_ENABLED=true
#
# Codeforces: whether students may submit from CPIntel, and how long a stored Codeforces session
# is kept before it has to be reconnected.
# CPINTEL_SUBMIT_ENABLED=true
# CPINTEL_SESSION_TTL_DAYS=14
# How often live group standings are rebuilt. Each rebuild is one Codeforces call per member.
# CPINTEL_STANDINGS_REFRESH_MS=180000
#
# Days between placement-gauntlet attempts. Answers are shown as it goes, so an immediate
# retake would test memory.
# CPINTEL_GAUNTLET_RETAKE_DAYS=7
#
# Examination monitor: how often the page reports in, and how long without a report before
# submissions to a monitored paper are refused. Keep the TTL about three intervals.
# CPINTEL_PROCTOR_HEARTBEAT_INTERVAL=15
# CPINTEL_PROCTOR_HEARTBEAT_TTL=45
# How often old examination logs are deleted (see CPINTEL_EXAM_RETENTION_DAYS).
# CPINTEL_EXAM_RETENTION_SWEEP_MS=86400000
#
# Personal files: whether a contest offers them unless an admin turns it off, and the limits
# per person (2 MB a file, 32 MB in all).
# CPINTEL_FILES_IN_CONTEST=true
# CPINTEL_FILES_MAX_FILES=100
# CPINTEL_FILES_MAX_FILE_BYTES=2097152
# CPINTEL_FILES_MAX_TOTAL_BYTES=33554432
#
# Development only — the backend running code itself (./start.sh), not the runner container,
# which always uses g++ -std=c++20, gcc -std=gnu11 and python3:
# CPINTEL_RUNNER_CPP=g++
# CPINTEL_RUNNER_CPP_STD=c++20
# CPINTEL_RUNNER_C=gcc
# CPINTEL_RUNNER_C_STD=gnu11
# CPINTEL_RUNNER_PYTHON=python3
#
# Not set here: SPRING_DATASOURCE_*, SPRING_DATA_MONGODB_URI, SPRING_DATA_REDIS_* and
# CPINTEL_RUNNER_URL are built by docker-compose.yml from the values above.
