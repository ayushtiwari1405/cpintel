{
  "manifest_version": 3,
  "name": "CPIntel Connector",
  "version": "0.4.0",
  "description": "Lets CPIntel open Codeforces and LeetCode problems and submit your solutions through this browser, where your sign-ins live.",
  "host_permissions": [
    "https://codeforces.com/*",
    "https://leetcode.com/*"
  ],
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "__CPINTEL_ORIGINS__"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
