# Base path the SPA calls. Versioned: the API lives under /api/v1.
VITE_API_URL=/api/v1

# Where users get the CPIntel Codeforces Connector extension (a Chrome Web Store link, or wherever
# you host extension/cpintel-codeforces.zip). Shown on Platforms to users without it. Build it
# with `CPINTEL_SERVER_URL=https://<server> node extension/build.mjs`.
VITE_CF_EXTENSION_URL=
