{
  "name": "cpintel-desktop",
  "version": "0.1.0",
  "description": "CPIntel Desktop App",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"cross-env NODE_ENV=development electron .\"",
    "build": "tsc && node scripts/stamp-server.mjs && node scripts/fetch-toolchains.mjs && node scripts/package.mjs",
    "pack": "tsc && node scripts/stamp-server.mjs && node scripts/fetch-toolchains.mjs && node scripts/package.mjs --dir",
    "test": "tsc && node --test dist",
    "toolchain": "node scripts/fetch-toolchains.mjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.cpintel.desktop",
    "productName": "CPIntel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "CPIntel-${version}-${arch}.${ext}",
      "maintainer": "CPIntel <cpintel@localhost>",
      "vendor": "CPIntel"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "CPIntel-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CPIntel-Setup-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "toolchain",
        "to": "toolchain"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": null
  }
}
