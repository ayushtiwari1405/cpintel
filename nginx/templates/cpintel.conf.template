# Rendered at container start: ${CPINTEL_DOMAIN} is filled in from the environment.

# ── rate limits ──────────────────────────────────────────────────────────────
#
# Keyed by address, which is right for the internet and wrong for a lab whose two hundred
# machines reach this server through one NAT address: to these limits the whole room is one
# very busy user. Addresses in CPINTEL_LAB_NETWORKS (written to lab-networks.inc at start) are
# held to the generous *_lab zones instead. The backend applies the same distinction to its
# own sign-in limit, and its per-account limits apply to everyone either way.
geo $lab_network {
    default 0;
    include /etc/nginx/lab-networks.inc;
}
map $lab_network $public_addr { 0 $binary_remote_addr; default ""; }
map $lab_network $lab_addr    { 0 "";                  default $binary_remote_addr; }

# An empty key is not limited, so each request is counted by exactly one of each pair.
# 429 rather than nginx's default 503: "slow down", which the frontend already handles, not
# "the server is broken".
limit_req_status 429;
limit_req_zone $public_addr zone=api:10m      rate=30r/s;
limit_req_zone $lab_addr    zone=api_lab:10m  rate=1000r/s;
limit_req_zone $public_addr zone=auth:10m     rate=5r/s;
limit_req_zone $lab_addr    zone=auth_lab:10m rate=100r/s;

upstream backend {
    server backend:8080;
    keepalive 32;
}

upstream frontend {
    server frontend:80;
    keepalive 16;
}

# ── :80 ──────────────────────────────────────────────────────────────────────
# Only three things: Let's Encrypt's challenge files, the health check Docker polls, and a
# redirect to https. Nothing with a password in it is ever served here.
server {
    listen 80;
    listen [::]:80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── :443 ─────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${CPINTEL_DOMAIN};

    # Chosen at start by docker-entrypoint.d/40-cpintel-tls.sh: Let's Encrypt, a certificate
    # mounted at /etc/nginx/certs, or a temporary self-signed one until one of those exists.
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS, CSP and the rest: nginx/security-headers.conf. Any location below with an
    # add_header of its own includes it again, or that location would send none of them.
    include /etc/nginx/security-headers.conf;

    # Auth endpoints — stricter rate limit
    location ~ ^/api/v1/auth/(login|register|refresh) {
        limit_req zone=auth burst=10 nodelay;
        limit_req zone=auth_lab burst=400 nodelay;
        proxy_pass         http://backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        # Overwritten, never appended: nginx is the edge, and the backend takes the leftmost
        # address in this header as the caller's. Appending kept whatever the client sent in
        # front of it, so "X-Forwarded-For: 1.2.3.4" from anybody made them 1.2.3.4 — a way
        # around every per-address rate limit and a forged address in the audit log.
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # The host and port the browser used, so the backend can tell a request from its own
        # page (same origin, no CORS) on any port. Without it Spring takes the port from
        # X-Forwarded-Proto's default, and on anything but 443 its own page looks foreign.
        proxy_set_header   X-Forwarded-Host $http_host;
        proxy_connect_timeout 10s;
        proxy_read_timeout    30s;
        # Spring Security sets these three as well; passing its copies on put two of each in
        # the response, and a browser obeys only the first HSTS, which was the backend's (with
        # includeSubDomains). nginx's own, from security-headers.conf, are the ones that count.
        proxy_hide_header  Strict-Transport-Security;
        proxy_hide_header  X-Frame-Options;
        proxy_hide_header  X-Content-Type-Options;
        # 502: nothing listening. 504: the address no longer answers, which is what a stopped or
        # recreated container looks like until nginx gives up on it (and also what a reply slower
        # than proxy_read_timeout gets). The page already treats 502, 504 and this JSON 503 alike
        # (api/client.ts unreachable): reads are retried, writes never are. Only the JSON is new.
        error_page 502 504 = @restarting;
    }

    # All other API endpoints
    location /api/ {
        limit_req zone=api burst=50 nodelay;
        limit_req zone=api_lab burst=2000 nodelay;
        proxy_pass         http://backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        # Overwritten, never appended: nginx is the edge, and the backend takes the leftmost
        # address in this header as the caller's. Appending kept whatever the client sent in
        # front of it, so "X-Forwarded-For: 1.2.3.4" from anybody made them 1.2.3.4 — a way
        # around every per-address rate limit and a forged address in the audit log.
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # The host and port the browser used, so the backend can tell a request from its own
        # page (same origin, no CORS) on any port. Without it Spring takes the port from
        # X-Forwarded-Proto's default, and on anything but 443 its own page looks foreign.
        proxy_set_header   X-Forwarded-Host $http_host;
        proxy_connect_timeout 10s;
        # Long enough for a Run that queued for a runner slot and then compiled.
        proxy_read_timeout    120s;
        # Spring Security sets these three as well; passing its copies on put two of each in
        # the response, and a browser obeys only the first HSTS, which was the backend's (with
        # includeSubDomains). nginx's own, from security-headers.conf, are the ones that count.
        proxy_hide_header  Strict-Transport-Security;
        proxy_hide_header  X-Frame-Options;
        proxy_hide_header  X-Content-Type-Options;
        # 502: nothing listening. 504: the address no longer answers, which is what a stopped or
        # recreated container looks like until nginx gives up on it (and also what a reply slower
        # than proxy_read_timeout gets). The page already treats 502, 504 and this JSON 503 alike
        # (api/client.ts unreachable): reads are retried, writes never are. Only the JSON is new.
        error_page 502 504 = @restarting;
    }

    # The backend is not answering: nearly always because it is restarting for a deploy, which
    # takes about half a minute. Said in JSON the page can read and retry on, rather than an HTML
    # 502 it would show as an error. Only nginx's own 502 comes here; a status the backend sends
    # passes through as it is.
    location @restarting {
        default_type application/json;
        include /etc/nginx/security-headers.conf;
        add_header Retry-After 5 always;
        return 503 '{"success":false,"code":"SERVER_RESTARTING","message":"The server is restarting. Try again in a few seconds; nothing you have saved is lost."}';
    }

    # Actuator: only the health check is public. Prometheus scrapes the backend directly on the
    # Docker network and never comes through here. This used to allow 10.0.0.0/8 and
    # 172.16.0.0/12, which on a campus network is every student, and /actuator/prometheus needs
    # no sign-in — so anyone in the building could read the backend's internals.
    location = /actuator/health {
        proxy_pass http://backend;
        # Spring Security's copies, as on the API locations: nginx's are the ones that count.
        proxy_hide_header  Strict-Transport-Security;
        proxy_hide_header  X-Frame-Options;
        proxy_hide_header  X-Content-Type-Options;
    }
    location /actuator/ {
        return 404;
    }

    # Frontend SPA
    location / {
        proxy_pass         http://frontend;
        proxy_http_version 1.1;
        proxy_set_header   Connection "";
        proxy_set_header   Host $host;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }
}
